<Project>
  <!--
    Central package management. Every NuGet version for the whole solution is
    declared here once; project files reference packages by name only.

    This exists because version drift is otherwise invisible: v1 had the same
    package pinned at different versions in different projects, and a security
    advisory had to be chased through four csproj files instead of one line.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Application shell">
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
  </ItemGroup>

  <ItemGroup Label="Rendering">
    <PackageVersion Include="Vortice.D3DCompiler" Version="3.6.2" />
    <PackageVersion Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageVersion Include="Vortice.DXGI" Version="3.6.2" />
    <PackageVersion Include="Vortice.Mathematics" Version="1.9.2" />
  </ItemGroup>

  <ItemGroup Label="Mesh interchange">
    <PackageVersion Include="AssimpNet" Version="5.0.0-beta1" />
    <PackageVersion Include="SharpGLTF.Toolkit" Version="1.0.6" />
  </ItemGroup>

  <ItemGroup Label="Textures and imaging">
    <PackageVersion Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageVersion Include="System.Drawing.Common" Version="8.0.0" />
    <PackageVersion Include="WriteableBitmapEx" Version="1.6.8" />
  </ItemGroup>

  <ItemGroup Label="Serialisation and compression">
    <!-- MessagePack must stay at or above 3.1.8: 3.1.4 carries GHSA-hv8m-jj95-wg3x. -->
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup Label="Reference index">
    <!--
      The costume-swapping code looks up where an object lives across packages
      through a database, and reads it with this. It comes across with that
      code from the tool it was copied from, at the version that tool pins.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
