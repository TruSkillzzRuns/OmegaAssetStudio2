<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A copy of the working Calligraphy reader, taken across whole rather than
    rewritten. It reads the game's own character, power and icon data, and it
    needs UpkManager's object model - which in this repository depends on
    Core, so this cannot live in Core without turning that round.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OmegaAssetStudio2.Calligraphy</AssemblyName>
    <RootNamespace>OmegaAssetStudio.Calligraphy</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UpkManager\UpkManager.csproj" />
  </ItemGroup>

</Project>
