<Window
    x:Class="OmegaAssetStudio2.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!--
        Four tools, one shell. The nav pane MinWidth is generous on purpose:
        every label must read in full at every window size, including the
        compact state. No ellipsis on nav entries.
    -->
    <muxc:NavigationView
        x:Name="Nav"
        PaneDisplayMode="Left"
        OpenPaneLength="240"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        SelectionChanged="Nav_SelectionChanged">

        <!--
            The mark sits above the tool list, where an application's name
            belongs. It is given its own row rather than drawn into the header
            text so that the pane can collapse to the mark alone and still say
            what this is.
        -->
        <muxc:NavigationView.PaneHeader>
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,6,4,10">
                <Image Source="ms-appx:///Assets/OmegaMark.png"
                       Height="30" Stretch="Uniform"
                       AutomationProperties.Name="Omega Asset Studio 2" />
                <TextBlock Text="OMEGA" VerticalAlignment="Center"
                           FontSize="17" FontWeight="SemiBold"
                           CharacterSpacing="180"
                           Foreground="{ThemeResource Omega.AccentBrush}" />
            </StackPanel>
        </muxc:NavigationView.PaneHeader>

        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem Content="Home" Tag="home">
                <muxc:NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>

            <muxc:NavigationViewItemSeparator />
            <muxc:NavigationViewItemHeader Content="TOOLS" />

            <muxc:NavigationViewItem Content="Skill Recolor" Tag="skillrecolor">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>

            <muxc:NavigationViewItem Content="Voice Swapper" Tag="voiceswapper">
                <muxc:NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Microphone" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>

            <muxc:NavigationViewItem Content="Icon Editor" Tag="iconeditor">
                <muxc:NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Pictures" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>

            <muxc:NavigationViewItem Content="Mesh" Tag="mesh">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>

            <muxc:NavigationViewItem Content="Retarget" Tag="retarget">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8AB;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>

            <muxc:NavigationViewItem Content="Character Swap" Tag="swap">
                <muxc:NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Switch" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>


            <muxc:NavigationViewItemSeparator />

            <muxc:NavigationViewItem Content="Omega Backup and Restore" Tag="backup">
                <muxc:NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Undo" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.MenuItems>

        <Frame x:Name="RootFrame" />
    </muxc:NavigationView>
</Window>
