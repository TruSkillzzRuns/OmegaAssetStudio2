<Page
    x:Class="OmegaAssetStudio2.App.Pages.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmegaAssetStudio2.App.Controls"
    xmlns:pages="using:OmegaAssetStudio2.App.Pages">

    <Grid Padding="{StaticResource Omega.PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="10">
            <controls:ToolHeader
                Title="Omega Backup and Restore"
                Subtitle="Every file this app has changed, and how to put it back." />
            <TextBlock x:Name="VaultText" Style="{StaticResource Omega.PageSubtitle}" TextWrapping="Wrap" />

            <!-- The three numbers worth knowing before reading a single row. -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Background="{ThemeResource Omega.PanelBrush}"
                        BorderBrush="{ThemeResource Omega.PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Omega.PanelCorner}"
                        Padding="16,10,18,10" MinWidth="128">
                    <StackPanel>
                        <TextBlock x:Name="ProtectedCount" Text="0" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="files protected" FontSize="12"
                                   Foreground="{ThemeResource Omega.SubtleTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource Omega.PanelBrush}"
                        BorderBrush="{ThemeResource Omega.PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Omega.PanelCorner}"
                        Padding="16,10,18,10" MinWidth="128">
                    <StackPanel>
                        <TextBlock x:Name="ChangedCount" Text="0" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{ThemeResource Omega.ChangedBrush}" />
                        <TextBlock Text="changed" FontSize="12"
                                   Foreground="{ThemeResource Omega.SubtleTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource Omega.PanelBrush}"
                        BorderBrush="{ThemeResource Omega.PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Omega.PanelCorner}"
                        Padding="16,10,18,10" MinWidth="128">
                    <StackPanel>
                        <TextBlock x:Name="UntouchedCount" Text="0" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{ThemeResource Omega.SafeBrush}" />
                        <TextBlock Text="untouched" FontSize="12"
                                   Foreground="{ThemeResource Omega.SubtleTextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="ClientFilter" Grid.Column="0" MinWidth="190"
                      SelectionChanged="ClientFilter_SelectionChanged"
                      ToolTipService.ToolTip="Show only the files belonging to one game." />

            <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Click="RefreshButton_Click" />
            <Button x:Name="ScanFolderButton" Grid.Column="2" Content="Also scan a folder" Click="ScanFolderButton_Click" />

            <TextBox x:Name="SearchBox" Grid.Column="3"
                     PlaceholderText="Search by file or folder name"
                     TextChanged="SearchBox_TextChanged" />

            <TextBlock x:Name="CountText" Grid.Column="4" VerticalAlignment="Center"
                       Style="{StaticResource Omega.PageSubtitle}" />
        </Grid>

        <Border Grid.Row="2"
                Background="{ThemeResource Omega.PanelBrush}"
                BorderBrush="{ThemeResource Omega.PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Omega.PanelCorner}">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- What kind of thing was changed. Every tab carries its own
                     count, so a glance says where the changes are without
                     opening any of them. A tab with nothing in it is hidden
                     rather than shown empty. -->
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Padding="6,6,6,0">
                    <StackPanel x:Name="CategoryTabs" Orientation="Horizontal" Spacing="6" />
                </ScrollViewer>

                <ListView x:Name="BackupList" Grid.Row="1" SelectionMode="Extended" Padding="4"
                          ItemContainerStyle="{StaticResource Omega.ListRow}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="pages:BackupRow">
                        <Grid Padding="4,12,8,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- What kind of file this is, in a word of one letter. -->
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource Omega.AccentWash}">
                                <TextBlock Text="{x:Bind Glyph}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Omega.AccentBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <!-- The name is the point of the row, so it wraps
                                     rather than being cut off at any width. -->
                                <TextBlock Text="{x:Bind FileName}"
                                           Style="{StaticResource Omega.RowText}"
                                           FontWeight="SemiBold" />

                                <!-- What kind of thing it is and whose it is,
                                     so a row says what was changed rather than
                                     only which file was. -->
                                <TextBlock Text="{x:Bind Belongs}"
                                           Style="{StaticResource Omega.RowText}"
                                           FontSize="12"
                                           Foreground="{ThemeResource Omega.AccentBrush}" />
                                <TextBlock Text="{x:Bind FolderPath}"
                                           Style="{StaticResource Omega.RowText}"
                                           FontSize="12"
                                           Foreground="{ThemeResource Omega.SubtleTextBrush}" />
                                <TextBlock Text="{x:Bind Note}"
                                           Style="{StaticResource Omega.RowText}"
                                           FontSize="12"
                                           Foreground="{ThemeResource Omega.AccentBrush}" />
                            </StackPanel>

                            <!-- One of these three shows. The colour carries the
                                 meaning; the word is there for anyone who does
                                 not read colour. -->
                            <Border Grid.Column="2" VerticalAlignment="Center"
                                    Visibility="{x:Bind ChangedPill}"
                                    Background="{ThemeResource Omega.ChangedWash}"
                                    CornerRadius="{StaticResource Omega.PillCorner}"
                                    Padding="12,4,12,5">
                                <TextBlock Text="changed" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource Omega.ChangedBrush}" />
                            </Border>

                            <Border Grid.Column="2" VerticalAlignment="Center"
                                    Visibility="{x:Bind UntouchedPill}"
                                    Background="{ThemeResource Omega.SafeWash}"
                                    CornerRadius="{StaticResource Omega.PillCorner}"
                                    Padding="12,4,12,5">
                                <TextBlock Text="untouched" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource Omega.SafeBrush}" />
                            </Border>

                            <Border Grid.Column="2" VerticalAlignment="Center"
                                    Visibility="{x:Bind GonePill}"
                                    Background="{ThemeResource Omega.GoneWash}"
                                    CornerRadius="{StaticResource Omega.PillCorner}"
                                    Padding="12,4,12,5">
                                <TextBlock Text="file is gone" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource Omega.GoneBrush}" />
                            </Border>

                            <TextBlock Grid.Column="3" Text="{x:Bind SizeText}"
                                       VerticalAlignment="Center" MinWidth="120"
                                       TextAlignment="Right"
                                       Style="{StaticResource Omega.PageSubtitle}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind TakenText}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Omega.PageSubtitle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="RestoreSelectedButton" Content="Restore selected" Click="RestoreSelected_Click"
                        Style="{StaticResource AccentButtonStyle}" MinWidth="140" />
                <Button x:Name="RestoreAllButton" Content="Restore everything shown" Click="RestoreAll_Click" />
                <Button x:Name="DeleteSelectedButton" Content="Forget selected" Click="DeleteSelected_Click" />
                <Button x:Name="SelectAllButton" Content="Select all shown" Click="SelectAll_Click" />
            </StackPanel>

            <Border Background="{ThemeResource Omega.PanelBrush}"
                    BorderBrush="{ThemeResource Omega.PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Omega.PanelCorner}"
                    Padding="12,10,12,10">
                <TextBlock x:Name="StatusText" Style="{StaticResource Omega.NameText}"
                           Text="Loading backups..." />
            </Border>
        </StackPanel>
    </Grid>
</Page>
