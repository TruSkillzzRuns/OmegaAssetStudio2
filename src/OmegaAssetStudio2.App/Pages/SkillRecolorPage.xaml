<Page
    x:Class="OmegaAssetStudio2.App.Pages.SkillRecolorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmegaAssetStudio2.App.Controls"
    xmlns:pages="using:OmegaAssetStudio2.App.Pages">

    <Grid Padding="{StaticResource Omega.PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="10">
            <controls:ToolHeader
                Title="Skill Recolor"
                Subtitle="Change the colours used by materials and by particle effects." />
            <controls:ClientSelector x:Name="ClientPicker" HorizontalAlignment="Left" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Colours are found by picking a hero and one of their skills.
                 There is nothing to scan for and no pattern to give: the game's
                 own data says which effects a skill plays and which packages
                 they live in. -->
            <Button x:Name="CancelButton" Grid.Column="0" Content="Stop" IsEnabled="False" Click="CancelButton_Click" />

            <TextBlock x:Name="CountText" Grid.Column="4" VerticalAlignment="Center"
                       Style="{StaticResource Omega.PageSubtitle}" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="190" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Who. Their skills stand in their own panel beside this
                 one, so a long character list and a long skill list are not
                 fighting over the same column of room. -->
            <Border Grid.Column="0"
                    Background="{ThemeResource Omega.PanelBrush}"
                    BorderBrush="{ThemeResource Omega.PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Omega.PanelCorner}"
                    Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="RosterSearchBox" Grid.Row="0"
                             PlaceholderText="Search by name"
                             TextChanged="RosterSearchBox_TextChanged" />

                    <ListView x:Name="RosterList" Grid.Row="1" SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="RosterList_ItemClick"
                              SelectionChanged="RosterList_SelectionChanged"
                              ItemContainerStyle="{StaticResource Omega.ListRow}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="pages:RosterRow">
                                <Grid Padding="2,6,2,6" ColumnSpacing="8"
                                      HorizontalAlignment="Stretch"
                                      Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Sized, not stretched, and the text is
                                         given the rest of the row so a long
                                         name still wraps in full. -->
                                    <Border Grid.Column="0" Width="32" Height="32"
                                            VerticalAlignment="Top"
                                            CornerRadius="4">
                                        <Image Source="{x:Bind Picture, Mode=OneWay}"
                                               Stretch="Uniform" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource Omega.RowText}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Detail}"
                                                   Style="{StaticResource Omega.RowText}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource Omega.SubtleTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <controls:PanelSplitter Grid.Column="1" />

            <!-- Which of their skills. -->
            <Border Grid.Column="2"
                    Background="{ThemeResource Omega.PanelBrush}"
                    BorderBrush="{ThemeResource Omega.PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Omega.PanelCorner}"
                    Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SkillsHeading" Grid.Row="0"
                               Text="Skills"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <TextBox x:Name="SkillSearchBox" Grid.Row="1"
                             PlaceholderText="Search skills"
                             TextChanged="SkillSearchBox_TextChanged" />

                    <ListView x:Name="SkillList" Grid.Row="2" SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="SkillList_ItemClick"
                              SelectionChanged="SkillList_SelectionChanged"
                              ItemContainerStyle="{StaticResource Omega.ListRow}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="pages:SkillRow">
                                <Grid Padding="2,6,2,6" ColumnSpacing="8"
                                      HorizontalAlignment="Stretch"
                                      Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Sized, not stretched, and the text is
                                         given the rest of the row so a long
                                         name still wraps in full. -->
                                    <Border Grid.Column="0" Width="32" Height="32"
                                            VerticalAlignment="Top"
                                            CornerRadius="4">
                                        <Image Source="{x:Bind Picture, Mode=OneWay}"
                                               Stretch="Uniform" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource Omega.RowText}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Detail}"
                                                   Style="{StaticResource Omega.RowText}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource Omega.SubtleTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <controls:PanelSplitter Grid.Column="3" />

            <Border Grid.Column="4"
                    Background="{ThemeResource Omega.PanelBrush}"
                    BorderBrush="{ThemeResource Omega.PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Omega.PanelCorner}">
                <ListView x:Name="MaterialList" SelectionMode="None"
                          ItemContainerStyle="{StaticResource Omega.ListRow}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="pages:ColourSlotRow">
                            <Grid Padding="4,8,4,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- A slot the reader cannot write is shown but
                                     cannot be ticked. Seeing every colour a
                                     skill uses is half of knowing which to
                                     change. -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{x:Bind Chosen, Mode=TwoWay}"
                                          IsEnabled="{x:Bind Editable}"
                                          MinWidth="0" />

                                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="4"
                                        VerticalAlignment="Top"
                                        Background="{x:Bind SwatchBrush}" />

                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="{x:Bind Name}"
                                               Style="{StaticResource Omega.RowText}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Detail}"
                                               Style="{StaticResource Omega.RowText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource Omega.SubtleTextBrush}" />
                                    <TextBlock Text="{x:Bind ValueText}"
                                               Style="{StaticResource Omega.RowText}"
                                               FontSize="11"
                                               Foreground="{ThemeResource Omega.SubtleTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <controls:PanelSplitter Grid.Column="5" />

            <ScrollViewer Grid.Column="6">
                <StackPanel Spacing="12">
                    <Border Background="{ThemeResource Omega.PanelBrush}"
                            BorderBrush="{ThemeResource Omega.PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Omega.PanelCorner}"
                            Padding="{StaticResource Omega.PanelPadding}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Colour"
                                       Style="{StaticResource Omega.NameText}"
                                       FontSize="16" FontWeight="SemiBold" />

                            <TextBlock Style="{StaticResource Omega.NameText}" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource Omega.SubtleTextBrush}"
                                       Text="Every ticked slot is set to this colour, scaled by how bright it already was. A curve keeps its shape, black stays black, and what was brightest stays brightest." />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4"
                                        x:Name="TargetSwatch" />

                                <Button Grid.Column="1" x:Name="PickButton"
                                        Content="Pick a colour"
                                        HorizontalAlignment="Stretch"
                                        Click="PickButton_Click" />
                            </Grid>

                            <TextBlock x:Name="TargetText"
                                       Style="{StaticResource Omega.NameText}" FontSize="12"
                                       Foreground="{ThemeResource Omega.SubtleTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource Omega.PanelBrush}"
                            BorderBrush="{ThemeResource Omega.PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Omega.PanelCorner}"
                            Padding="{StaticResource Omega.PanelPadding}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Apply"
                                       Style="{StaticResource Omega.NameText}"
                                       FontSize="16" FontWeight="SemiBold" />

                            <TextBlock Style="{StaticResource Omega.NameText}" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource Omega.SubtleTextBrush}"
                                       Text="Each package is backed up once, before its first change. Only the ticked slots are touched — a shared material keeps every other material in its file untouched." />

                            <Button x:Name="SaveButton" Content="Apply to the ticked slots"
                                    HorizontalAlignment="Stretch" IsEnabled="False"
                                    Click="SaveButton_Click" />

                            <Button x:Name="RevertButton" Content="Untick everything"
                                    HorizontalAlignment="Stretch" IsEnabled="False"
                                    Click="RevertButton_Click" />

                            <TextBlock x:Name="SaveMessage"
                                       Style="{StaticResource Omega.NameText}" FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3"
                Background="{ThemeResource Omega.PanelBrush}"
                BorderBrush="{ThemeResource Omega.PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Omega.PanelCorner}"
                Padding="12,10,12,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource Omega.NameText}" VerticalAlignment="Center"
                           Text="Pick a game above, then find materials." />
                <ProgressBar x:Name="ScanBar" Grid.Column="1" Width="200"
                             VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
