<Page
    x:Class="OmegaAssetStudio2.App.Pages.CharacterSwapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmegaAssetStudio2.App.Controls">

    <Grid Padding="{StaticResource Omega.PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="10">
            <controls:ToolHeader
                Title="Character Swap"
                Subtitle="Take a costume from a newer game and make it load in an older one." />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="14">

            <!-- The usual way: say which game each side is, and pick one of the
                 pairs already worked out. Naming the files outright is still
                 there underneath, for anything not on the list. -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Browsed for rather than chosen from a list: the build
                     costumes come from is usually one kept aside somewhere,
                     not one installed and set up in this application. -->
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Take costumes from" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FromFolderBox" Grid.Column="0" IsReadOnly="True"
                                 PlaceholderText="No build chosen" TextWrapping="NoWrap" />
                        <Button x:Name="FromFolderButton" Grid.Column="1" Content="Browse…"
                                Click="FromFolder_Click" MinWidth="100" />
                    </Grid>
                    <TextBlock x:Name="FromFolderNote" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Put them into" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="IntoClientBox" HorizontalAlignment="Stretch"
                              PlaceholderText="Which game" SelectionChanged="Client_Changed" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Text="Costume" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="PairBox" HorizontalAlignment="Stretch"
                          PlaceholderText="Which costume, and what it replaces"
                          SelectionChanged="Pair_Changed" />
                <TextBlock x:Name="PairNote" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <Expander x:Name="ByHandExpander" Header="Or name the files yourself"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14">
            <StackPanel Spacing="6">
                <TextBlock Text="Take the costume from" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="A costume package from the newer game. Only ever read."
                           Opacity="0.7" TextWrapping="Wrap" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TakeFromBox" Grid.Column="0" IsReadOnly="True"
                             PlaceholderText="No costume chosen" TextWrapping="NoWrap" />
                    <Button x:Name="TakeFromButton" Grid.Column="1" Content="Choose a costume…"
                            Click="TakeFrom_Click" MinWidth="150" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Replace this costume" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="The costume in the older game that the result stands in for. Only ever read."
                           Opacity="0.7" TextWrapping="Wrap" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ReplaceBox" Grid.Column="0" IsReadOnly="True"
                             PlaceholderText="No costume chosen" TextWrapping="NoWrap" />
                    <Button x:Name="ReplaceButton" Grid.Column="1" Content="Choose a costume…"
                            Click="Replace_Click" MinWidth="150" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Write the result to" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.7"
                           Text="Somewhere of your own, never into the game. Copy it in yourself once you have looked at it — that way a costume that does not work cannot take the game with it." />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="WriteToBox" Grid.Column="0" IsReadOnly="True"
                             PlaceholderText="Nowhere chosen" TextWrapping="NoWrap" />
                    <Button x:Name="WriteToButton" Grid.Column="1" Content="Choose where…"
                            Click="WriteTo_Click" MinWidth="150" />
                </Grid>
            </StackPanel>

                </StackPanel>
            </Expander>

            <StackPanel Spacing="6">
                <CheckBox x:Name="IntoTheGameBox" IsChecked="True" Checked="Where_Changed"
                          Unchecked="Where_Changed"
                          Content="Put it straight into the game, over the costume it replaces" />
                <TextBlock x:Name="WhereNote" Opacity="0.7" TextWrapping="Wrap" Margin="28,0,0,0" />
            </StackPanel>

            <StackPanel Spacing="6">
                <CheckBox x:Name="MatchedTranslateBox" IsChecked="True"
                          Content="Give the older costume's objects the newer one's contents" />
                <CheckBox x:Name="MergeWithTargetBox" IsChecked="True"
                          Content="…and keep the older costume's own where the newer names nothing (recommended)" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RunButton" Content="Make the swap" Click="Run_Click"
                        Style="{StaticResource AccentButtonStyle}" MinWidth="160" IsEnabled="False" />
                <Button x:Name="OpenFolderButton" Content="Show me the result" Click="OpenFolder_Click"
                        MinWidth="150" IsEnabled="False" />
                <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Background="{ThemeResource Omega.PanelBrush}"
                CornerRadius="6" Padding="12" MinHeight="160">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="ReportText" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                           FontFamily="Consolas"
                           Text="Choose a costume to take, a costume to replace, and somewhere to put the result." />
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" Opacity="0.75" TextWrapping="Wrap" />
    </Grid>
</Page>
