<UserControl
    x:Class="OmegaAssetStudio2.App.Controls.ToolHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="6" Margin="0,0,0,20">
        <TextBlock x:Name="TitleText" Style="{StaticResource Omega.PageTitle}" />
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Omega.PageSubtitle}" />
        <Border Height="2" Background="{ThemeResource Omega.AccentBrush}"
                HorizontalAlignment="Stretch" Margin="0,8,0,0" Opacity="0.5" />
    </StackPanel>
</UserControl>
