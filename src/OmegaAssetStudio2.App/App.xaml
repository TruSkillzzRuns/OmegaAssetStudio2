<Application
    x:Class="OmegaAssetStudio2.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The Skill Recolor page was taken across from the first studio
                whole, and looks these brushes up by name at runtime rather than
                through XAML. Both themes are answered, so that page follows the
                chosen theme like every other one; the values match the tokens
                the rest of the application uses.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="OmegaAssetStudio.PanelBackgroundBrush" Color="#FF1B1922" />
                    <SolidColorBrush x:Key="OmegaAssetStudio.PanelSecondaryBrush" Color="#FF24202E" />
                    <SolidColorBrush x:Key="OmegaAssetStudio.PanelBorderBrush" Color="#FF3B3348" />
                    <SolidColorBrush x:Key="OmegaAssetStudio.AccentBrush" Color="#FFB258FF" />
                    <SolidColorBrush x:Key="OmegaAssetStudio.OnAccentBrush" Color="#FF120F18" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OmegaAssetStudio.PanelBackgroundBrush" Color="#FFF7F5FB" />
                    <SolidColorBrush x:Key="OmegaAssetStudio.PanelSecondaryBrush" Color="#FFEFEAF7" />
                    <SolidColorBrush x:Key="OmegaAssetStudio.PanelBorderBrush" Color="#FFDCD4E7" />
                    <SolidColorBrush x:Key="OmegaAssetStudio.AccentBrush" Color="#FF7A26C9" />
                    <SolidColorBrush x:Key="OmegaAssetStudio.OnAccentBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
